{
    "name": "@durable-actors/pi-durable",
    "version": "0.1.0",
    "description": "Run Pi Durable agents inside Durable Actors",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "test": "bun test tests",
        "format": "prettier --write src tests",
        "format:check": "prettier --check src tests",
        "prepack": "bun run build && bun run check && bun run test"
    },
    "dependencies": {
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "1.2.0",
        "@earendil-works/pi-durable": "1.2.0",
        "durable-actors": "^0.8.0",
        "@earendil-works/chord": "1.2.0"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.2.0",
        "@earendil-works/pi-durable": "1.2.0",
        "durable-actors": "workspace:*",
        "@types/bun": "^1.3.0",
        "@types/node": "^22.0.0",
        "typescript": "~5.9.3"
    }
}
