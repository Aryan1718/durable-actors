{
    "name": "durable-actors-observer",
    "version": "0.9.0",
    "description": "Embeddable React observer for Durable Actors",
    "type": "module",
    "license": "MIT",
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/durable-actors.git",
        "directory": "packages/observer-ui"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./standalone/*": "./dist/standalone/*",
        "./theme.css": "./dist/theme.css"
    },
    "files": [
        "dist",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "vite build --mode library && vite build && tsc -p tsconfig.json",
        "test": "bun test --parallel=1 tests/*.test.tsx",
        "format": "prettier --write src tests vite.config.ts index.html",
        "format:check": "prettier --check src tests vite.config.ts index.html",
        "prepack": "bun run --bun build && bun run --bun test && bun run --bun package:check",
        "package:check": "bun test --timeout 60000 tests/package.test.mjs",
        "dev": "vite",
        "preview": "vite preview"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/react": "^16.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.1.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.0"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "eventsource-parser": "^4.1.1",
        "jsondiffpatch": "^0.7.6",
        "lucide-react": "^1.47.0",
        "react-day-picker": "^10.0.1",
        "react-json-view-lite": "^2.5.0",
        "tailwind-merge": "^3.7.0",
        "vaul": "^1.1.2"
    }
}
