{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "publicUrl": {"type": "string", "pattern": "^https://[^/?#@]+/?$"},
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+[a-z]$"}
      },
      "required": ["zone"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"},
        "region": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$"},
        "actorRoleArn": {"type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"},
        "express": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buckets": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9]+-az[0-9]+--x-s3$"},
                  "zone": {"type": "string", "pattern": "^[a-z0-9]+-az[0-9]+$"}
                },
                "required": ["bucket", "zone"]
              }
            },
            "placement": {"type": "string", "enum": ["all", "nearest"]}
          },
          "required": ["buckets", "placement"]
        }
      },
      "required": ["bucket", "region", "actorRoleArn"]
    },
    "credentialsSecret": {"type": "string", "minLength": 1},
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "tlsSecret": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "required": ["enabled", "className", "tlsSecret", "annotations"]
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 100},
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warm": {"type": "integer", "minimum": 0, "maximum": 256},
        "cpuMillis": {"type": "integer", "minimum": 1},
        "cpuLimitMillis": {"type": ["integer", "null"], "minimum": 1},
        "memoryMiB": {"type": "integer", "minimum": 1},
        "memoryLimitMiB": {"type": ["integer", "null"], "minimum": 1}
      },
      "required": ["warm", "cpuMillis", "memoryMiB"]
    },
    "alarms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"pollIntervalMs": {"type": "integer", "minimum": 1}},
      "required": ["pollIntervalMs"]
    },
    "organizationLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxActiveActors": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "actorStartsPerSecond": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "actorStartBurst": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      },
      "required": ["enabled", "maxActiveActors", "actorStartsPerSecond", "actorStartBurst"]
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"maxConnections": {"type": "integer", "minimum": 1, "maximum": 1000}},
      "required": ["maxConnections"]
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"urlSecretKey": {"type": "string"}, "caSecretKey": {"type": "string"}}
    },
    "resources": {"type": "object"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPlane": {"$ref": "#/definitions/image"},
        "typescript": {"$ref": "#/definitions/image"},
        "python": {"$ref": "#/definitions/image"}
      },
      "required": ["controlPlane", "typescript", "python"]
    },
    "sandboxNamespace": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dnsCidrs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ipFamily": {"enum": ["IPv4", "IPv6"]}
      },
      "required": ["dnsCidrs", "ipFamily"]
    }
  },
  "required": [
    "publicUrl", "placement", "storage", "credentialsSecret", "ingress", "replicaCount", "actors",
    "alarms", "organizationLimits", "postgres", "resources", "images", "sandboxNamespace", "nodeSelector",
    "networkPolicy"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["repository", "digest"]
    }
  }
}
