{
    "name": "durable-actors",
    "version": "0.14.3",
    "description": "Provider-neutral actors for sandbox compute",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "engines": {
        "bun": ">=1.4.2"
    },
    "packageManager": "bun@1.4.2",
    "keywords": [
        "actors",
        "distributed-systems",
        "durable-actors",
        "kubernetes",
        "serverless"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/durable-actors.git",
        "directory": "sdk"
    },
    "homepage": "https://github.com/TerseAI/durable-actors#readme",
    "bugs": {
        "url": "https://github.com/TerseAI/durable-actors/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "durable-actors": "bin/durable-actors.js"
    },
    "exports": {
        "./backend": {
            "types": "./dist/backend.d.ts",
            "import": "./dist/backend.js",
            "default": "./dist/backend.js"
        },
        "./dev": {
            "types": "./dist/localRuntime.d.ts",
            "import": "./dist/localRuntime.js",
            "default": "./dist/localRuntime.js"
        },
        "./proxy": {
            "types": "./dist/proxy.d.ts",
            "import": "./dist/proxy.js",
            "default": "./dist/proxy.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./host": {
            "types": "./dist/host.d.ts",
            "import": "./dist/host.js",
            "default": "./dist/host.js"
        },
        "./observe": {
            "types": "./dist/observe.d.ts",
            "import": "./dist/observe.js",
            "default": "./dist/observe.js"
        },
        "./compiler": {
            "types": "./dist/compiler/actor-compiler.d.ts",
            "import": "./dist/compiler/actor-compiler.js",
            "default": "./dist/compiler/actor-compiler.js"
        },
        "./codegen": {
            "types": "./dist/compiler/generators/client-artifacts.d.ts",
            "import": "./dist/compiler/generators/client-artifacts.js",
            "default": "./dist/compiler/generators/client-artifacts.js"
        }
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "bun run --bun build:observer && bun run --bun build:client && tsc -p tsconfig.build.json && bun run --bun build:declarations && bun scripts/build-template.mjs",
        "check": "bun run --bun format:check && bun run --bun test && bun run --bun package:check",
        "clean": "rm -rf dist .test-dist",
        "package:check": "bun test --timeout 60000 tests/scripts/codegen-api.test.mjs tests/scripts/build-artifact.test.mjs tests/scripts/standalone-client.test.mjs tests/scripts/host-runtime.test.mjs",
        "prepack": "bun run --bun clean && bun run --bun build && bun run --bun package:check",
        "test": "bun run --bun clean && bun run --bun build && bun tests/prepare.mjs && tsc -p tsconfig.test.json && bun test --parallel=1 --timeout 60000 ./.test-dist/tests",
        "format": "prettier --config ../.prettierrc --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"tests/**/*.mjs\"",
        "format:check": "prettier --config ../.prettierrc --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"tests/**/*.mjs\"",
        "build:observer": "bun run --bun --cwd ../packages/observer-ui build",
        "docs": "typedoc --options typedoc.json",
        "build:client": "bun scripts/build-client-runtime.mjs",
        "build:declarations": "bun scripts/build-declaration-compiler.mjs"
    },
    "dependencies": {
        "@types/json-schema": "^7.0.15",
        "ajv": "^8.20.0",
        "commander": "^14.0.3",
        "durable-actors-observer": "workspace:*",
        "esbuild": "^0.28.2",
        "import-meta-resolve": "^4.2.0",
        "open": "^10.2.0",
        "prettier": "^3.9.6",
        "tar": "^7.5.22",
        "typescript": "~5.9.3",
        "typescript-json-schema": "^0.68.0",
        "validate-npm-package-name": "^6.0.2",
        "vite": "^8.3.0",
        "ws": "^8.18.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/validate-npm-package-name": "^4.0.2",
        "@types/ws": "^8.18.1",
        "dts-bundle-generator": "9.5.1",
        "typedoc": "^0.28.20",
        "typedoc-plugin-missing-exports": "^4.1.4"
    }
}
