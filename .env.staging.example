# Replace all example names and paths with your own staging resources.
STAGING_GCP_PROJECT=your-staging-project
STAGING_GKE_CLUSTER=your-staging-cluster
STAGING_GKE_LOCATION=us-central1-a
STAGING_NODE_POOL=your-staging-node-pool
STAGING_IMAGE_REPOSITORY=us-central1-docker.pkg.dev/your-staging-project/your-staging-images/persistence-tests
STAGING_PROBE_NAMESPACE=your-staging-probe-namespace
STAGING_PROBE_DEPLOYMENT=your-staging-probe-deployment
KUBECONFIG=/absolute/path/to/staging-kubeconfig.yaml
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/staging-credentials.json
# Optional separate credential file for gcloud and the GKE auth plugin.
# CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE=/path/to/user-credentials.json

DURABLE_ACTORS_PROJECT_ID=your-staging-actor-project
DURABLE_ACTORS_PROCESS_ROLE=control_plane
DURABLE_ACTORS_CONTROL_PLANE_BIND=127.0.0.1:7200
DURABLE_ACTORS_CONTROL_PLANE_URL=https://your-staging-domain.ngrok.app
DURABLE_ACTORS_PUBLIC_URL=https://your-staging-domain.ngrok.app
DURABLE_ACTORS_POSTGRES_URL=
DURABLE_ACTORS_JWT_SIGNING_KEY=
DURABLE_ACTORS_SECRET=
DURABLE_ACTORS_PERSISTENCE=rapid
DURABLE_ACTORS_BUCKET=your-staging-authority
DURABLE_ACTORS_ARTIFACT_BUCKET=your-staging-artifacts
DURABLE_ACTORS_ARCHIVE_BUCKET=your-staging-archive
DURABLE_ACTORS_RAPID_BUCKETS='[{"bucket":"your-staging-rapid-a","zone":"us-central1-a"},{"bucket":"your-staging-rapid-b","zone":"us-central1-b"}]'
DURABLE_ACTORS_GKE_ZONE=us-central1-a
DURABLE_ACTORS_GKE_NAMESPACE=your-staging-actor-tests
DURABLE_ACTORS_SPARE_IDLE=0
NGROK_DOMAIN=your-staging-domain.ngrok.app
NGROK_AUTH_TOKEN=
STAGING_SECRET_KEYS=
